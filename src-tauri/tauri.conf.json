{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "file-j",
  "version": "0.1.0",
  "identifier": "com.jiangwanyi.filej",
  "build": {
    "beforeDevCommand": "pnpm backend:build && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm backend:build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "file-j",
        "width": 1240,
        "height": 800,
        "minWidth": 940,
        "minHeight": 580,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:* ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "双栏文件管理与 SSH/SFTP 传输工具",
    "longDescription": "file-j 是一款 WinSCP 式双栏文件管理器，支持本地文件拷贝移动与 SSH/SFTP 远程文件传输。",
    "externalBin": ["binaries/file-jd"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "exceptionDomain": ""
    }
  }
}
