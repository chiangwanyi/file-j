{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FileJ",
        "width": 1240,
        "height": 800,
        "minWidth": 940,
        "minHeight": 580,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}